<p class="eyebrow" style="color:#8b9aa8;font-size:13px;letter-spacing:.08em;text-transform:uppercase;margin-bottom:4px"><%= round.label %></p>
<p style="color:#d8e0e8;margin:0 0 24px"><% if random %>Nobody voted, so <strong><%= club.name %></strong> picked at random:<% else %>The votes are in for <strong><%= club.name %></strong>.<% end %></p>
<table role="presentation" border="0" cellpadding="0" cellspacing="0" class="film">
  <tr>
    <% if film.poster_url %>
      <td style="padding:0 16px 16px 0;vertical-align:top;width:100px">
        <img src="<%= film.poster_url %>" width="100" alt="" style="display:block;border-radius:4px">
      </td>
    <% end %>
    <td style="padding:0 0 16px;vertical-align:top;color:#d8e0e8">
      <a href="<%= film.letterboxd_url %>" class="title-link" style="color:#d8e0e8;text-decoration:none;font-size:18px;font-weight:bold"><%= film.title %></a><% if film.year %>
        <span class="meta" style="color:#8b9aa8"><%= film.year %></span><% end %><br>
      <span class="meta" style="color:#8b9aa8;font-size:14px"><% if film.director %>dir. <%= film.director %><br><% end %><% if film.rating %>★ <%= film.rating_display %> on Letterboxd<% end %></span>
    </td>
  </tr>
</table>
<% if standings && !standings.empty? %>
  <p class="meta" style="color:#8b9aa8;font-size:14px;margin-bottom:4px">Borda count — a first pick scores <%= standings.size %>, a last pick 1.</p>
  <table role="presentation" border="0" cellpadding="0" cellspacing="0" class="standings">
    <% standings.each_with_index do |s, i| %>
      <tr>
        <td class="rank" style="color:#8b9aa8;font-size:14px;padding:0 8px 8px 0;vertical-align:top"><%= i + 1 %>.</td>
        <%# Film#display, not the bare title: every film reference carries
            director and rating, runners-up included. %>
        <td class="meta" style="color:#8b9aa8;font-size:14px;padding:0 0 8px"><%= s[:film].display %> — <%= s[:points] %> pts<%= s[:firsts] > 0 ? ", #{s[:firsts]} first-place" : "" %></td>
      </tr>
    <% end %>
  </table>
<% end %>
<p style="color:#d8e0e8;margin-top:16px">Watch it whenever you like, then log it on Letterboxd. The next round doesn't open until everyone has — we check your diary, so there's nothing to reply to.</p>
<%= Mailer.button(club_url, "Club page") %>
