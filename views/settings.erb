<nav>
  <a href="/">Your clubs</a>
  <span class="sep" aria-hidden="true">›</span>
  <span>Settings</span>
</nav>

<h1>Settings</h1>

<section class="section">
  <h2>Account</h2>
  <p class="dim">Signed in as <%= user.email %>. Ask whoever runs your club if that needs to change.</p>
</section>

<section class="section">
  <h2>Email</h2>
  <% if user.unsubscribed_at %>
    <p>You unsubscribed on <%= Fmt.date(user.unsubscribed_at) %>, so we're not sending you ballots &mdash;
      and your watchlist isn't counting toward what your clubs pick.</p>
    <form method="post" action="/settings/resubscribe">
      <%== csrf_tag("/settings/resubscribe") %>
      <button type="submit">Start sending them again</button>
    </form>
  <% else %>
    <p class="dim">We email you a ballot when a round opens, and the result when it closes.
      Every one of those carries an unsubscribe link; you can turn them back on here afterwards.</p>
  <% end %>
</section>

<section class="section">
  <h2>Letterboxd</h2>
  <p>We read this account's public watchlist once a week to work out what everyone wants to see.</p>
  <% if error %><p class="err"><%= error %></p><% end %>
  <form method="post" action="/settings">
    <%== csrf_tag("/settings") %>
    <p><input type="text" name="letterboxd_username" value="<%= username %>"
              placeholder="username" autocapitalize="off" autocorrect="off" spellcheck="false"></p>
    <p class="dim">
      Username only &mdash; not the full URL, though we'll cope. Your watchlist has to be public.
      <%# Said plainly here rather than behind a confirm: it's recoverable
          (change it back and the next crawl fills it in again), but somebody
          swapping accounts should know their votes-in-waiting go with it. %>
      Changing this drops the watchlist we hold for you and reads the new
      account's instead.
    </p>
    <button type="submit">Save</button>
  </form>
</section>

<%# Only Letterboxd's export carries a full watch history. The two pages we read
    every night between them reach back about 50 diary entries and 72 films by
    release date, and every route that would serve more is behind a challenge.
    Hence asking people to upload it. %>
<section class="section" id="import">
  <h2>Films you've already seen</h2>
  <p>Clubs that draw from a fixed list &mdash; a Top 250, someone's best-of &mdash; skip
     films any of you has already watched. We read what you've logged lately, and what
     you've rated, from your Letterboxd profile &mdash; but the rest of your history only
     comes from their data export. We can't bulk read your whole watched film history
     without rate limiting.</p>
  <p class="dim">
    <% if seen_count.positive? %>
      <%= Fmt.number(seen_count) %> watched <%= seen_count == 1 ? "film" : "films" %> on file.
      Uploading again adds to it; nothing is ever removed.
    <% else %>
      Nothing on file yet, so a fixed-list club can only skip what you've logged or rated lately.
    <% end %>
  </p>
  <ol class="how">
    <li>Open <a href="https://letterboxd.com/user/exportdata/" target="_blank">letterboxd.com/user/exportdata/</a>
        and press <strong>Export your data</strong>. It arrives as a zip.</li>
    <li>Unzip it. Inside is <strong>watched.csv</strong> &mdash; that's the one.
        (<code>watchlist.csv</code> is films you want to see; we already read those.)</li>
    <li>Upload it here.</li>
  </ol>
  <form method="post" action="/settings/import" enctype="multipart/form-data" id="import-form">
    <%== csrf_tag("/settings/import") %>
    <p><input type="file" name="watched" accept=".csv,text/csv" required></p>
    <p class="dim">We keep the film names and nothing else &mdash; no dates, no ratings, no reviews.</p>
    <button type="submit">Import</button>
  </form>
</section>

<script>
  // Nothing is ever removed from a watch history, so importing the wrong file
  // is the one mistake here you can't take back. Confirm before uploading, and
  // name the file back to them — watchlist.csv is the easy slip.
  (function () {
    var form = document.getElementById('import-form');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      var file = form.querySelector('input[type=file]').files[0];
      if (!file) return;
      // Browsers rename duplicate downloads (watched (1).csv), so match on the
      // stem rather than the exact name. Anything else gets a louder warning,
      // and watchlist.csv — the file sitting next to it in the same zip, and
      // the one people actually grab by mistake — gets named outright.
      var name = file.name.toLowerCase();
      // One paragraph per string, no hard wrapping — the dialog wraps to its
      // own width, and breaking the lines ourselves fights it.
      var paras, mismatch = !/^watched\b/.test(name);
      if (/^watchlist\b/.test(name)) {
        paras = ['WARNING: "' + file.name + '" looks like your watchlist, not your watch history.',
                 'watchlist.csv is films you want to see. Importing it would mark them all watched and stop your clubs from ever picking them. You want watched.csv from the same export.'];
      } else if (mismatch) {
        paras = ['WARNING: "' + file.name + '" is not named watched.csv.',
                 'A Letterboxd export calls your watch history watched.csv. Check you unzipped the export and picked that one — not watchlist.csv, which is films you want to see.'];
      } else {
        paras = ['Import "' + file.name + '" as films you have already watched?',
                 'This should be watched.csv from your Letterboxd export — films you want to see live in watchlist.csv, and we already read those.'];
      }
      paras.push('Nothing can be removed once imported.' + (mismatch ? ' Import anyway?' : ''));
      if (!window.confirm(paras.join('\n\n'))) e.preventDefault();
    });
  })();
</script>
