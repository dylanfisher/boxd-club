<%# One member: their face and their name, the way Letterboxd shows a member —
    a small round avatar and the name in bold sans.

    Linked accounts have the whole row as the link to their Letterboxd profile,
    so the avatar is clickable too. Someone who hasn't set a username yet gets
    the same row minus the link, so a half-set-up club doesn't look broken. %>
<% if user.linked? %>
  <a class="member" href="<%= user.letterboxd_url %>" target="letterboxd"><%
    %><%== render("avatar", locals: { user: user }) %><%
    %><span class="member-name"><%= user.letterboxd_username %></span><%
  %></a>
<% else %>
  <span class="member"><%
    %><%== render("avatar", locals: { user: user }) %><%
    %><span class="member-name"><%= user.display_name %></span><%
    %><span class="dim">(no Letterboxd account yet)</span><%
  %></span>
<% end %>
