<%# Development only — see the /dev/emails routes. Styled inline rather than
    from the layout: none of this ships, and the layout's stylesheet is for
    pages members actually see. %>
<nav>
  <a href="/dev/emails">All emails</a>
</nav>

<h1><%= preview[:subject] %></h1>

<section class="section">
  <p class="dim">
    <%= preview[:name] %> · <%= preview[:note] %> ·
    <code><%= "emails/#{preview[:template]}" %>.{html,text}.erb</code>
  </p>
  <%# Above the parts rather than under them: it's in the same place on the
      index and on every preview, so clicking through doesn't move it. %>
  <%== render("email_preview_nav", locals: { previews: previews, current: preview[:name] }) %>
</section>

<section class="section">
  <h2>HTML part</h2>
  <%# In a frame so the email's own markup is the only thing acting on it —
      that's the whole point of looking at it. %>
  <iframe src="/dev/emails/<%= preview[:name] %>/html" title="HTML part"
          style="width:100%;height:40rem;border:1px solid var(--line);border-radius:.4rem;background:#14181c"></iframe>
  <p class="dim"><a href="/dev/emails/<%= preview[:name] %>/html">Open on its own</a></p>
</section>

<section class="section">
  <h2>Text part</h2>
  <p class="dim">What people reading in a plain-text client get — this is a real part of every message, not a fallback.</p>
  <pre style="white-space:pre-wrap;overflow-x:auto;background:var(--card);border:1px solid var(--line);border-radius:.4rem;padding:var(--space-4);font-size:.85rem"><%= text %></pre>
  <p class="dim"><a href="/dev/emails/<%= preview[:name] %>/text">Open on its own</a></p>
</section>
