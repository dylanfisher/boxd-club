<nav>
  <a href="/admin">Admin</a>
  <span class="sep" aria-hidden="true">›</span>
  <a href="<%= club.path %>">Club page</a>
</nav>

<h1><%= club.name %></h1>

<section class="section">
  <div class="card">
    <form method="post" action="/admin/clubs/<%= club.slug %>">
      <%== csrf_tag("/admin/clubs/#{club.slug}") %>
      <label for="name">Name</label>
      <p><input type="text" id="name" name="name" value="<%= club.name %>" required></p>
      <label for="list_mode">Where the films come from</label>
      <p>
        <select id="list_mode" name="list_mode">
          <% Club::MODES.each do |m| %>
            <option value="<%= m %>"<%= m == club.list_mode ? " selected" : "" %>><%= Club::MODE_ICONS[m] %> <%= Club::MODE_LABELS[m] %></option>
          <% end %>
        </select>
      </p>
      <%# All three watchlist modes read the same pool; only the overlap they
          demand differs. Spelling that out here saves a support conversation. %>
      <ul class="mode-notes">
        <% Club::MODES.each do |m| %>
          <li>
            <span class="icon" aria-hidden="true"><%= Club::MODE_ICONS[m] %></span>
            <span><b><%= Club::MODE_LABELS[m] %></b> — <%= Club::MODE_NOTES[m] %></span>
          </li>
        <% end %>
      </ul>
      <label for="list_url">Letterboxd list URL</label>
      <p><input type="text" id="list_url" name="list_url" value="<%= club.list_url %>"
                placeholder="https://letterboxd.com/user/list/name/"></p>
      <label for="ballot_size">Films per ballot</label>
      <p><input type="number" id="ballot_size" name="ballot_size" value="<%= club.ballot_size %>" min="2" max="10"></p>
      <label>Reminders</label>
      <%# An unticked box posts nothing, so the hidden field carries the "off"
          and the checkbox overrides it when ticked. %>
      <input type="hidden" name="auto_nudge" value="0">
      <p class="dim">
        <label>
          <input type="checkbox" name="auto_nudge" value="1"<%= club.auto_nudge ? " checked" : "" %>>
          Email people who haven't voted, every <%= Rounds::NUDGE_DAYS %> days
        </label>
      </p>
      <button type="submit">Save</button>
    </form>
  </div>
</section>

<%# Only list-mode clubs have a list to read. The count is what the matcher
    actually has to work with, so a fresh club reading "0 films, never read"
    explains an empty ballot before anyone has to go looking. %>
<% if club.list_mode == "list" && club.list_url %>
  <section class="section">
    <div class="card">
      <form method="post" action="/admin/clubs/<%= club.slug %>/refetch-list">
        <%== csrf_tag("/admin/clubs/#{club.slug}/refetch-list") %>
        <label>The club's list</label>
        <p class="dim">
          <a href="<%= club.list_url %>" target="letterboxd"><%= club.list_owner %>/<%= club.list_slug %></a> ·
          <%= club.list_size %> films ·
          <% fetched = club.list_fetched_at %>
          <%= fetched ? "read #{Fmt.ago(fetched)}" : "never read" %>
        </p>
        <button type="submit">Re-read list</button>
        <p class="dim">
          Otherwise it's re-read by the nightly job, once it's more than
          <%= Letterboxd::REFRESH_AFTER / 86_400 %> days old.
        </p>
      </form>
    </div>
  </section>
<% end %>

<section class="section">
  <h2>Members</h2>
  <ul class="films">
    <% list_mode = club.list_mode == "list" %>
    <%# Counted once, not once a member: list_size is a COUNT(*). %>
    <% list_size = Fmt.number(club.list_size) if list_mode %>
    <% members.each do |m| %>
      <li>
        <%== render("avatar", locals: { user: m }) %>
        <span class="title">
          <%= m.email %>
          <br><span class="meta">
            <%= m.letterboxd_username || "no Letterboxd account" %> ·
            <%# Which count is worth reading depends on where the club's films
                come from: a watchlist club draws from these watchlists, while a
                list club draws from its list and this member's share of it is
                what they've already seen. %>
            <% if list_mode %>
              <%= Fmt.number(watched_on_list.fetch(m.id, 0)) %> of <%= list_size %> watched
            <% else %>
              <%= Fmt.number(m.watchlist_size) %> on watchlist
            <% end %>
            <%# Empty and never-fetched look identical in a bare count, and
                they need different fixes — one is a private watchlist, the
                other is a member the nightly job hasn't reached yet. %>
            <% if m.linked? %>
              <% fetched = m.watchlist_fetched_at %>
              · <%= fetched ? "read #{Fmt.ago(fetched)}" : "never read" %>
            <% end %> ·
            <% if m.unsubscribed_at %>unsubscribed<% elsif m.verified_at %>active<% else %>invited, not signed in yet<% end %>
          </span>
        </span>
        <% if m.linked? %>
          <form method="post" action="/admin/clubs/<%= club.slug %>/refetch">
            <%== csrf_tag("/admin/clubs/#{club.slug}/refetch") %>
            <input type="hidden" name="user_id" value="<%= m.id %>">
            <button class="secondary" type="submit">Re-read watchlist</button>
          </form>
        <% end %>
        <form method="post" action="/admin/clubs/<%= club.slug %>/remove">
          <%== csrf_tag("/admin/clubs/#{club.slug}/remove") %>
          <input type="hidden" name="user_id" value="<%= m.id %>">
          <button class="secondary" type="submit">Remove</button>
        </form>
      </li>
    <% end %>
  </ul>
</section>

<section class="section">
  <div class="card">
    <form method="post" action="/admin/clubs/<%= club.slug %>/invite">
      <%== csrf_tag("/admin/clubs/#{club.slug}/invite") %>
      <label for="email">Invite someone to this club</label>
      <p><input type="email" id="email" name="email" placeholder="them@example.com" required></p>
      <button type="submit">Send invite</button>
    </form>
  </div>
</section>

<section class="section">
  <h2>Current round</h2>
  <% if round.nil? %>
    <p class="dim">Nothing open.</p>
  <% else %>
    <p class="dim">
      <a href="<%= round.path %>"><%= round.label %></a> · <%= round.state %> · opened <%= Fmt.date(round.opened_at) %>
      <% if round.open? %>
        · waiting on <%= round.pending_voters.map(&:display_name).join(", ").then { |s| s.empty? ? "nobody" : s } %>
      <% elsif round.decided? %>
        · <%= Film[round.winning_film_id]&.display %>
        · still to log it: <%= round.pending_loggers.map(&:display_name).join(", ").then { |s| s.empty? ? "nobody" : s } %>
        · votes to skip: <%= round.skip_voters.size %> of <%= round.skips_needed %>
      <% end %>
    </p>
    <ol class="films">
      <% candidates.each do |cand, film| %>
        <li>
          <span class="pos"><%= cand.position %>.</span>
          <%== render("film", locals: { film: film, note: "#{cand.match_count} on watchlists" }) %>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>

<section class="section">
  <div class="card">
    <p class="dim">Overrides. Rounds normally move themselves along — use these when a club is stuck.</p>

    <%# Separate from the overrides below: this one changes nothing, it just
        emails the people who still owe a ballot. %>
    <form method="post" action="/admin/clubs/<%= club.slug %>/nudge">
      <%== csrf_tag("/admin/clubs/#{club.slug}/nudge") %>
      <% waiting = round&.open? ? round.pending_voters : [] %>
      <button type="submit"<%= waiting.empty? ? " disabled" : "" %>>
        <% if round.nil? || !round.open? %>
          Nudge non-voters
        <% elsif waiting.empty? %>
          Everyone's voted
        <% else %>
          Nudge <%= waiting.size %> <%= waiting.size == 1 ? "person" : "people" %> who haven't voted
        <% end %>
      </button>
      <p class="dim">
        <% if waiting.any? %>
          <%= waiting.map(&:display_name).join(", ") %>.
        <% end %>
        Sends straight away, ignoring the every-<%= Rounds::NUDGE_DAYS %>-days limit on automatic reminders.
      </p>
    </form>

    <hr>

    <% %w[open tally check watched].each do |action| %>
      <form method="post" action="/admin/clubs/<%= club.slug %>/round/<%= action %>" style="display:inline-block; margin: .25rem .25rem 0 0">
        <%== csrf_tag("/admin/clubs/#{club.slug}/round/#{action}") %>
        <button class="secondary" type="submit">
          <%= { "open" => "Open a round now", "tally" => "Tally now",
                "check" => "Re-check who's logged it", "watched" => "Mark watched, start next" }[action] %>
        </button>
      </form>
    <% end %>
  </div>
</section>

<%# The undo for a club that started before it was ready. Kept apart from the
    overrides above, and behind a typed slug, because it's the only button on
    this page that throws away something people did. %>
<section class="section">
  <div class="card">
    <form method="post" action="/admin/clubs/<%= club.slug %>/reset">
      <%== csrf_tag("/admin/clubs/#{club.slug}/reset") %>
      <label for="confirm">Reset the club</label>
      <p class="dim">
        Deletes
        <% if club.never_started? %>
          every round — there aren't any yet.
        <% else %>
          all <%= club.rounds.size %> <%= club.rounds.size == 1 ? "round" : "rounds" %>,
          with their ballots, votes and history.
        <% end %>
        <%= club.name %> goes back to never having played, and stays there until
        you open the first round by hand — so it's the way to undo a club that
        started before everyone had signed up. Members, invites and watchlists
        are untouched. Ballot emails already sent will point at a round that's
        gone.
      </p>
      <p><input type="text" id="confirm" name="confirm" placeholder="<%= club.slug %>"
                autocomplete="off" required></p>
      <button class="secondary" type="submit">Type the slug to reset</button>
    </form>
  </div>
</section>

<section class="section">
  <h2>History</h2>
  <ul class="films">
    <% history.each do |r| %>
      <%== render("round_card", locals: { round: r }) %>
    <% end %>
  </ul>
</section>
